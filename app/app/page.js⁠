"use client";
import React, { useState, useEffect, useRef } from "react";
import { db, storage } from "../firebase";
import { 
  collection, addDoc, getDocs, updateDoc, doc, query, where, serverTimestamp, increment 
} from "firebase/firestore";
import { ref, uploadBytes, getDownloadURL } from "firebase/storage";
import QRCode from "qrcode";
import jsPDF from "jspdf";
import { 
  QrCode, UserPlus, CheckCircle, AlertTriangle, Search, LogOut, FileText, Send, 
  DollarSign, Clock, Users, Building, ShieldCheck, Camera, Layers
} from "lucide-react";

const BRANCHES = [
  "টালিগঞ্জ", "রবীন্দ্র সরোবর", "নিউটাউন", "সোদপুর", "হাওড়া", "বারাসাত"
];

export default function App() {
  // Auth State
  const [currentUser, setCurrentUser] = useState(null); // { role: 'owner' | 'trainer', branch: string }
  const [authInput, setAuthInput] = useState({ username: "", password: "" });
  const [activeTab, setActiveTab] = useState("attendance");

  // Form State
  const [formData, setFormData] = useState({
    name: "", phone: "", whatsapp: "", courseType: "Scooty", packageDays: "10",
    totalFees: "", paidAmount: "", dueAmount: "", isFullPay: false, branch: "টালিগঞ্জ",
    hasGovId: false, idType: "Aadhaar", idNumber: ""
  });
  const [studentPhoto, setStudentPhoto] = useState(null);
  const [loading, setLoading] = useState(false);
  const [qrCodeUrl, setQrCodeUrl] = useState("");
  const [newStudentId, setNewStudentId] = useState("");

  // Data State
  const [students, setStudents] = useState([]);
  const [selectedStudent, setSelectedStudent] = useState(null);
  const [scanResult, setScanResult] = useState(null);
  const [scannerActive, setScannerActive] = useState(false);
  const [searchTerm, setSearchTerm] = useState("");

  // Edit Modal State
  const [editingStudent, setEditingStudent] = useState(null);

  // Authentication Handler
  const handleLogin = (e) => {
    e.preventDefault();
    const { username, password } = authInput;
    if (username === "admin" && password === "owner@2026") {
      setCurrentUser({ role: "owner", branch: "All" });
      setActiveTab("dashboard");
    } else {
      const matchedBranch = BRANCHES.find(b => username.toLowerCase() === b.toLowerCase());
      if (matchedBranch && password === "trainer123") {
        setCurrentUser({ role: "trainer", branch: matchedBranch });
        setFormData(prev => ({ ...prev, branch: matchedBranch }));
        setActiveTab("attendance");
      } else {
        alert("ভুল আইডি বা পাসওয়ার্ড! অনুগ্রহ করে সঠিক তথ্য দিন।");
      }
    }
  };

  const handleLogout = () => {
    setCurrentUser(null);
    setAuthInput({ username: "", password: "" });
  };

  // Fetch Students
  const fetchStudents = async () => {
    try {
      const q = collection(db, "students");
      const snap = await getDocs(q);
      const list = snap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setStudents(list);
    } catch (err) {
      console.error(err);
    }
  };

  useEffect(() => {
    if (currentUser) {
      fetchStudents();
    }
  }, [currentUser]);

  // Form Calculation
  const handleFeeChange = (total, paid, fullPay) => {
    const t = Number(total) || 0;
    let p = Number(paid) || 0;
    if (fullPay) p = t;
    const d = Math.max(0, t - p);
    setFormData(prev => ({
      ...prev,
      totalFees: total,
      paidAmount: fullPay ? total : paid,
      dueAmount: d.toString(),
      isFullPay: fullPay
    }));
  };

  // Admission Submit
  const handleAdmission = async (e) => {
    e.preventDefault();
    if (!studentPhoto) {
      alert("কাস্টমারের ছবি ম্যান্ডেটরি!");
      return;
    }
    setLoading(true);
    try {
      let photoUrl = "";
      const storageRef = ref(storage, `photos/${Date.now()}_${studentPhoto.name}`);
      const uploadRes = await uploadBytes(storageRef, studentPhoto);
      photoUrl = await getDownloadURL(uploadRes.ref);

      const studentCode = `STW-${formData.branch.slice(0, 3).toUpperCase()}-${Date.now().toString().slice(-4)}`;
      const qrData = JSON.stringify({ studentCode, phone: formData.phone, branch: formData.branch });
      const generatedQr = await QRCode.toDataURL(qrData);

      const newStudent = {
        name: formData.name,
        phone: formData.phone,
        whatsapp: formData.whatsapp || formData.phone,
        courseType: formData.courseType,
        packageDays: Number(formData.packageDays),
        totalFees: Number(formData.totalFees) || 0,
        paidAmount: Number(formData.paidAmount) || 0,
        dueAmount: Number(formData.dueAmount) || 0,
        branch: formData.branch,
        studentCode,
        photoUrl,
        hasGovId: formData.hasGovId,
        idType: formData.idType,
        idNumber: formData.idNumber,
        classesAttended: 0,
        firstClassDate: null,
        status: "Active",
        createdAt: new Date().toISOString()
      };

      const docRef = await addDoc(collection(db, "students"), newStudent);
      setNewStudentId(docRef.id);
      setQrCodeUrl(generatedQr);
      alert("অ্যাডমিশন সফলভাবে সম্পন্ন হয়েছে!");
      fetchStudents();
    } catch (err) {
      alert("সমস্যা হয়েছে: " + err.message);
    }
    setLoading(false);
  };

  // HTML5 Scanner Setup
  useEffect(() => {
    let html5QrCode;
    if (scannerActive) {
      import("html5-qrcode").then(({ Html5Qrcode }) => {
        html5QrCode = new Html5Qrcode("reader");
        html5QrCode.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: { width: 250, height: 250 } },
          async (decodedText) => {
            try {
              const data = JSON.parse(decodedText);
              handleAttendanceScan(data.studentCode);
              html5QrCode.stop();
              setScannerActive(false);
            } catch (err) {
              alert("ভুল বা ইনভ্যালিড কিউআর কোড!");
            }
          },
          (errorMessage) => {}
        );
      });
    }
    return () => {
      if (html5QrCode && html5QrCode.isScanning) {
        html5QrCode.stop().catch(err => console.error(err));
      }
    };
  }, [scannerActive]);

  // Attendance Scan Processing
  const handleAttendanceScan = async (code) => {
    const student = students.find(s => s.studentCode === code);
    if (!student) {
      alert("কাস্টমার খুঁজে পাওয়া যায়নি!");
      return;
    }

    // Rule 1: 6th class fee check
    if (student.classesAttended >= 5 && student.dueAmount > 0) {
      alert(`⚠️ সতর্কবার্তা: ${student.name}-এর ₹${student.dueAmount} টাকা বকেয়া রয়েছে! ৫টি ক্লাসের বেশি হয়ে গেছে। পেমেন্ট ক্লিয়ার না করলে পরবর্তী ক্লাস কাউন্ট করা যাবে না।`);
      return;
    }

    // Rule 2: Package completion check
    if (student.classesAttended >= student.packageDays) {
      alert(`এই কোর্সটি সম্পন্ন হয়েছে (${student.classesAttended}/${student.packageDays} ক্লাস সম্পন্ন)।`);
      return;
    }

    // Rule 3: 90 days validity
    if (student.firstClassDate) {
      const diffDays = Math.floor((new Date() - new Date(student.firstClassDate)) / (1000 * 60 * 60 * 24));
      if (diffDays > 90) {
        alert("⚠️ ৯০ দিনের কোর্স ভ্যালিডিটি শেষ হয়ে গেছে!");
        return;
      }
    }

    try {
      const studentRef = doc(db, "students", student.id);
      const updatePayload = {
        classesAttended: increment(1),
        lastAttendedAt: new Date().toISOString()
      };
      if (!student.firstClassDate) {
        updatePayload.firstClassDate = new Date().toISOString();
      }
      await updateDoc(studentRef, updatePayload);
      alert(`✅ ক্লাস সফলভাবে কাউন্ট করা হয়েছে! বর্তমান ক্লাস: ${student.classesAttended + 1}/${student.packageDays}`);
      fetchStudents();
    } catch (err) {
      alert("অ্যাটেন্ডেন্স যোগ করতে ব্যর্থ: " + err.message);
    }
  };

  // PDF Generation with QR
  const downloadReceipt = async (student) => {
    const doc = new jsPDF();
    doc.setFontSize(18);
    doc.text("KOLKATA SCOOTY & BIKE TRAINING CENTRE", 20, 20);
    doc.setFontSize(12);
    doc.text(`Branch: ${student.branch}`, 20, 30);
    doc.text(`Date: ${new Date().toLocaleDateString()}`, 150, 30);
    doc.line(20, 35, 190, 35);

    doc.text(`Student Name: ${student.name}`, 20, 45);
    doc.text(`Phone: ${student.phone}`, 20, 55);
    doc.text(`Course: ${student.courseType} (${student.packageDays} Days Package)`, 20, 65);
    doc.text(`Total Fees: Rs. ${student.totalFees}`, 20, 75);
    doc.text(`Paid Amount: Rs. ${student.paidAmount}`, 20, 85);
    doc.text(`Due Amount: Rs. ${student.dueAmount}`, 20, 95);

    const qrData = JSON.stringify({ studentCode: student.studentCode, phone: student.phone, branch: student.branch });
    const qrImage = await QRCode.toDataURL(qrData);
    doc.addImage(qrImage, "JPEG", 130, 45, 50, 50);
    doc.text("Student ID QR Code", 140, 100);

    doc.line(20, 110, 190, 110);
    doc.setFontSize(10);
    doc.text("Terms: Complete your due payment within 5 classes. Validity: 90 days from 1st class.", 20, 120);
    doc.save(`${student.name}_Receipt.pdf`);
  };

  if (!currentUser) {
    return (
      <div className="min-h-screen flex items-center justify-center p-4 bg-slate-900">
        <div className="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md">
          <div className="text-center mb-6">
            <h1 className="text-2xl font-bold text-slate-800">শিখো টু হুইলার</h1>
            <p className="text-sm text-slate-500 mt-1">লগইন প্যানেল</p>
          </div>
          <form onSubmit={handleLogin} className="space-y-4">
            <div>
              <label className="block text-sm font-medium text-slate-700">ইউজারনেম / ব্রাঞ্চের নাম</label>
              <input 
                type="text" 
                placeholder="admin অথবা টালিগঞ্জ, সোদপুর ইত্যাদি" 
                value={authInput.username}
                onChange={e => setAuthInput({ ...authInput, username: e.target.value })}
                className="mt-1 block w-full p-3 border rounded-xl border-slate-300 focus:ring-2 focus:ring-blue-500"
                required
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-slate-700">পাসওয়ার্ড</label>
              <input 
                type="password" 
                placeholder="••••••••" 
                value={authInput.password}
                onChange={e => setAuthInput({ ...authInput, password: e.target.value })}
                className="mt-1 block w-full p-3 border rounded-xl border-slate-300 focus:ring-2 focus:ring-blue-500"
                required
              />
            </div>
            <button type="submit" className="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold p-3 rounded-xl shadow-md transition duration-200">
              লগইন করুন
            </button>
          </form>
        </div>
      </div>
    );
  }

  const filteredStudents = students.filter(s => {
    const matchesBranch = currentUser.role === "owner" ? (currentUser.branch === "All" ? true : s.branch === currentUser.branch) : s.branch === currentUser.branch;
    const matchesSearch = s.name.toLowerCase().includes(searchTerm.toLowerCase()) || s.phone.includes(searchTerm);
    return matchesBranch && matchesSearch;
  });

  return (
    <div className="min-h-screen bg-slate-100 flex flex-col">
      {/* Top Navbar */}
      <header className="bg-white shadow-sm border-b px-4 py-3 flex items-center justify-between sticky top-0 z-50">
        <div className="flex items-center space-x-2">
          <ShieldCheck className="text-blue-600 h-6 w-6" />
          <span className="font-bold text-slate-800 text-lg">শিখো ২-হুইলার</span>
          <span className="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full font-semibold">
            {currentUser.role === "owner" ? "Owner Panel" : `${currentUser.branch} Branch`}
          </span>
        </div>
        <button onClick={handleLogout} className="flex items-center text-sm font-medium text-red-600 hover:text-red-700">
          <LogOut className="h-4 w-4 mr-1" /> লগআউট
        </button>
      </header>

      {/* Main Container */}
      <main className="flex-1 max-w-5xl w-full mx-auto p-4 space-y-4">
        {/* Navigation Tabs */}
        <div className="flex space-x-2 border-b border-slate-200 pb-2">
          {currentUser.role === "owner" && (
            <button onClick={() => setActiveTab("dashboard")} className={`px-4 py-2 rounded-lg font-medium text-sm ${activeTab === "dashboard" ? "bg-blue-600 text-white" : "bg-white text-slate-600"}`}>
              রেভিনিউ ড্যাশবোর্ড
            </button>
          )}
          <button onClick={() => setActiveTab("attendance")} className={`px-4 py-2 rounded-lg font-medium text-sm ${activeTab === "attendance" ? "bg-blue-600 text-white" : "bg-white text-slate-600"}`}>
            স্ক্যানার ও অ্যাটেন্ডেন্স
          </button>
          <button onClick={() => setActiveTab("admission")} className={`px-4 py-2 rounded-lg font-medium text-sm ${activeTab === "admission" ? "bg-blue-600 text-white" : "bg-white text-slate-600"}`}>
            নতুন অ্যাডমিশন
          </button>
          <button onClick={() => setActiveTab("students")} className={`px-4 py-2 rounded-lg font-medium text-sm ${activeTab === "students" ? "bg-blue-600 text-white" : "bg-white text-slate-600"}`}>
            কাস্টমার তালিকা
          </button>
        </div>

        {/* OWNER DASHBOARD TAB */}
        {activeTab === "dashboard" && currentUser.role === "owner" && (
          <div className="space-y-4">
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div className="bg-white p-4 rounded-xl border border-slate-200">
                <p className="text-xs text-slate-500 font-semibold uppercase">মোট অ্যাডমিশন</p>
                <p className="text-2xl font-bold text-slate-800">{students.length}</p>
              </div>
              <div className="bg-white p-4 rounded-xl border border-slate-200">
                <p className="text-xs text-slate-500 font-semibold uppercase">মোট সংগৃহীত ফিস</p>
                <p className="text-2xl font-bold text-green-600">₹{students.reduce((acc, s) => acc + (s.paidAmount || 0), 0)}</p>
              </div>
              <div className="bg-white p-4 rounded-xl border border-slate-200">
                <p className="text-xs text-slate-500 font-semibold uppercase">মোট বকেয়া (Due)</p>
                <p className="text-2xl font-bold text-red-600">₹{students.reduce((acc, s) => acc + (s.dueAmount || 0), 0)}</p>
              </div>
              <div className="bg-white p-4 rounded-xl border border-slate-200">
                <p className="text-xs text-slate-500 font-semibold uppercase">Bike vs Scooty</p>
                <p className="text-sm font-bold text-slate-700">
                  🏍️ {students.filter(s => s.courseType === "Bike").length} | 🛵 {students.filter(s => s.courseType === "Scooty").length}
                </p>
              </div>
            </div>
          </div>
        )}

        {/* SCANNER & ATTENDANCE TAB */}
        {activeTab === "attendance" && (
          <div className="bg-white p-6 rounded-2xl border border-slate-200 space-y-4 text-center">
            <h2 className="text-lg font-bold text-slate-800">QR কোড স্ক্যানার</h2>
            <div className="max-w-xs mx-auto">
              <div id="reader" className="w-full bg-slate-50 rounded-xl overflow-hidden min-h-[250px] border border-dashed flex items-center justify-center">
                {!scannerActive && <p className="text-sm text-slate-400">ক্যামেরা অন করতে নিচে চাপ দিন</p>}
              </div>
            </div>
            <button 
              onClick={() => setScannerActive(!scannerActive)}
              className="bg-blue-600 text-white font-semibold px-6 py-2.5 rounded-xl shadow hover:bg-blue-700 transition"
            >
              {scannerActive ? "ক্যামেরা বন্ধ করুন" : "ক্যামেরা অন করুন"}
            </button>
          </div>
        )}

        {/* ADMISSION FORM TAB */}
        {activeTab === "admission" && (
          <div className="bg-white p-6 rounded-2xl border border-slate-200">
            <h2 className="text-lg font-bold text-slate-800 mb-4">নতুন স্টুডেন্ট অ্যাডমিশন ফর্ম</h2>
            <form onSubmit={handleAdmission} className="space-y-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-slate-700">কাস্টমারের পুরো নাম *</label>
                  <input type="text" required value={formData.name} onChange={e => setFormData({ ...formData, name: e.target.value })} className="w-full p-2.5 border rounded-lg border-slate-300" />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700">ফোন নম্বর *</label>
                  <input type="tel" required value={formData.phone} onChange={e => setFormData({ ...formData, phone: e.target.value })} className="w-full p-2.5 border rounded-lg border-slate-300" />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700">কোর্স ক্যাটাগরি</label>
                  <select value={formData.courseType} onChange={e => setFormData({ ...formData, courseType: e.target.value })} className="w-full p-2.5 border rounded-lg border-slate-300">
                    <option value="Scooty">Scooty</option>
                    <option value="Bike">Bike</option>
                  </select>
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700">প্যাকেজ ডিউরেশন</label>
                  <select value={formData.packageDays} onChange={e => setFormData({ ...formData, packageDays: e.target.value })} className="w-full p-2.5 border rounded-lg border-slate-300">
                    <option value="10">10 Days Package (10 Classes)</option>
                    <option value="15">15 Days Package (15 Classes)</option>
                  </select>
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700">টোটাল ফিস (₹) *</label>
                  <input type="number" required value={formData.totalFees} onChange={e => handleFeeChange(e.target.value, formData.paidAmount, formData.isFullPay)} className="w-full p-2.5 border rounded-lg border-slate-300" />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700">জমা দেওয়া টাকা (₹)</label>
                  <input type="number" disabled={formData.isFullPay} value={formData.paidAmount} onChange={e => handleFeeChange(formData.totalFees, e.target.value, false)} className="w-full p-2.5 border rounded-lg border-slate-300" />
                </div>
              </div>

              <div className="flex items-center space-x-2">
                <input type="checkbox" id="fullPay" checked={formData.isFullPay} onChange={e => handleFeeChange(formData.totalFees, formData.paidAmount, e.target.checked)} className="h-4 w-4 text-blue-600 rounded" />
                <label htmlFor="fullPay" className="text-sm font-medium text-slate-700">সম্পূর্ণ টাকা একবারে পরিশোধ (Full Pay)</label>
              </div>

              <div>
                <label className="block text-sm font-medium text-slate-700">কাস্টমারের ছবি * (Mandatory)</label>
                <input type="file" accept="image/*" required onChange={e => setStudentPhoto(e.target.files[0])} className="w-full p-2 border rounded-lg border-slate-300" />
              </div>

              <div className="p-3 bg-slate-50 rounded-xl space-y-2">
                <div className="flex items-center space-x-2">
                  <input type="checkbox" id="govId" checked={formData.hasGovId} onChange={e => setFormData({ ...formData, hasGovId: e.target.checked })} className="h-4 w-4 text-blue-600 rounded" />
                  <label htmlFor="govId" className="text-sm font-medium text-slate-700">Govt ID Proof যোগ করুন (Optional)</label>
                </div>
                {formData.hasGovId && (
                  <div className="grid grid-cols-2 gap-2 mt-2">
                    <select value={formData.idType} onChange={e => setFormData({ ...formData, idType: e.target.value })} className="p-2 border rounded-lg">
                      <option value="Aadhaar">Aadhaar Card</option>
                      <option value="Voter">Voter Card</option>
                      <option value="DL">Driving License</option>
                    </select>
                    <input type="text" placeholder="ID Number" value={formData.idNumber} onChange={e => setFormData({ ...formData, idNumber: e.target.value })} className="p-2 border rounded-lg" />
                  </div>
                )}
              </div>

              <button type="submit" disabled={loading} className="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold p-3 rounded-xl shadow">
                {loading ? "জমা হচ্ছে..." : "অ্যাডমিশন সম্পন্ন করুন"}
              </button>
            </form>
          </div>
        )}

        {/* STUDENT LIST TAB */}
        {activeTab === "students" && (
          <div className="space-y-4">
            <input 
              type="text" 
              placeholder="নাম বা ফোন নম্বর দিয়ে খুঁজুন..." 
              value={searchTerm} 
              onChange={e => setSearchTerm(e.target.value)}
              className="w-full p-3 border rounded-xl border-slate-300 bg-white"
            />
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {filteredStudents.map(student => (
                <div key={student.id} className="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-3">
                  <div className="flex items-center space-x-3">
                    <img src={student.photoUrl || "https://via.placeholder.com/60"} alt={student.name} className="w-12 h-12 rounded-full object-cover border" />
                    <div>
                      <h3 className="font-bold text-slate-800">{student.name}</h3>
                      <p className="text-xs text-slate-500">{student.phone} • {student.branch}</p>
                    </div>
                  </div>
                  
                  {/* Progress Bar */}
                  <div>
                    <div className="flex justify-between text-xs font-semibold mb-1">
                      <span>ক্লাস অগ্রগতি: {student.classesAttended || 0}/{student.packageDays}</span>
                      <span className={student.dueAmount > 0 ? "text-red-500" : "text-green-600"}>
                        {student.dueAmount > 0 ? `বাকি: ₹${student.dueAmount}` : "পেইড"}
                      </span>
                    </div>
                    <div className="w-full bg-slate-100 rounded-full h-2">
                      <div 
                        className="bg-blue-600 h-2 rounded-full" 
                        style={{ width: `${Math.min(100, ((student.classesAttended || 0) / student.packageDays) * 100)}%` }}
                      ></div>
                    </div>
                  </div>

                  <div className="flex space-x-2 pt-2 border-t">
                    <button onClick={() => downloadReceipt(student)} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold p-2 rounded-lg flex items-center justify-center">
                      <FileText className="w-3.5 h-3.5 mr-1" /> রিসিট PDF
                    </button>
                    {student.dueAmount > 0 && (
                      <a 
                        href={`https://wa.me/91${student.whatsapp}?text=নমস্কার%20${student.name},%20শিখো%20টু-হুইলার%20ট্রেনিং%20সেন্টার%20থেকে%20জানানো%20হচ্ছে%20আপনার%20₹${student.dueAmount}%20টাকা%20ফিস%20বকেয়া%20রয়েছে।%20অনুগ্রহ%20করে%20পরবর্তী%20ক্লাসের%20মধ্যে%20পরিশোধ%20করুন।`} 
                        target="_blank" 
                        rel="noreferrer"
                        className="bg-green-500 hover:bg-green-600 text-white text-xs font-semibold p-2 rounded-lg flex items-center justify-center"
                      >
                        <Send className="w-3.5 h-3.5 mr-1" /> WhatsApp রিমাইন্ডার
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </main>
    </div>
  );
}
